<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Nightshift.Core\Nightshift.Core.csproj" />
    <ProjectReference Include="..\Nightshift.Adapters\Nightshift.Adapters.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nightshift</ToolCommandName>
    <PackageId>Nightshift.Cli</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Version>0.3.2</Version>
    <Authors>Nightshift contributors</Authors>
    <Description>Personal DOT workflow orchestration with durable runs and a Codex process adapter.</Description>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <Content Include="Assets/**/*" CopyToOutputDirectory="PreserveNewest" Pack="false" />
  </ItemGroup>
</Project>
